#!/bin/sh
# continuum - see the limit coming, decide what to do, pick up where you stopped.
#
#   continuum status            utilization of every window the provider reports
#   continuum reset             local HH:MM when the primary window rolls over (+90s)
#   continuum estimate          extrapolate time remaining at current pace
#   continuum providers         list available providers
#   continuum check [--session ID] [--agent NAME]
#                               print a warning if a new tier was crossed, else nothing
#   continuum watch [seconds]   poll until the threshold is crossed, then say so
#   continuum resume HH:MM [dir] [prompt]
#                               schedule the agent to pick up after the reset
#   continuum history           show recent usage snapshots
#   continuum cleanup           remove stale flag/cache files (>24h old)
#   continuum statusline [key value | reset]
#                               show or configure status-line format
#
#   CONTINUUM_PROVIDER=mock continuum status     pick a provider (default: anthropic)
#   CONTINUUM_AGENT=claude                       pick an agent (default: claude)
#   CONTINUUM_RESUME_CMD='codex exec "{prompt}"' or give the resume command outright
set -eu

# Resolve lib/ whether we run in place, via a PATH symlink, or from a plugin install.
self="$0"; link=$(readlink "$self" 2>/dev/null) && [ -n "$link" ] && case "$link" in
    /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;;
esac
for d in "$(dirname "$self")/../lib" "${CONTINUUM_ROOT:-}/lib" "${CLAUDE_PLUGIN_ROOT:-}/lib"; do
    [ -f "$d/core.sh" ] || continue
    CNT_ROOT=$(cd "$d/.." && pwd)   # core.sh cannot find this itself: $0 is the caller
    export CNT_ROOT
    . "$d/core.sh"
    break
done
command -v cnt_read >/dev/null 2>&1 || { echo "continuum: lib/core.sh not found" >&2; exit 1; }
cnt_set_root_pointer

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

label() {  # pretty names for the windows a provider reports
    case "$1" in
        5h) printf '5 hours ' ;; 7d) printf '7 days  ' ;;
        *)  printf '%-8s' "$1" ;;
    esac
}

# sq <string> -> the string with single quotes escaped for embedding as
# '<value>' inside a generated shell fragment (plist, systemd unit, daemon
# wrapper). Without this a project dir like /tmp/o'brien breaks out of the
# quoting and injects shell. Call at schedule time, embed the result.
sq() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# Capture before piping: `cnt_read | while` would hide the provider's exit status
# behind the loop's, and a caller checking `continuum status` would see success.
cmd_status() {
    lines=$(cnt_read) || exit 1
    printf '%s\n' "$lines" | while read -r window util reset; do
        [ -z "$window" ] && continue
        when="?"
        [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
        printf '%s %5s%%   resets at %s\n' "$(label "$window")" "$util" "$when"
    done
    # Append to history log (best-effort, never fail)
    hist="$CNT_STATE/.continuum-history.log"
    mkdir -p "$CNT_STATE" 2>/dev/null || true
    ts=$(date '+%Y-%m-%d %H:%M')
    summary=$(printf '%s\n' "$lines" | awk '{printf "%s:%s%% ", $1, $2}' | sed 's/ $//')
    printf '%s  %s\n' "$ts" "$summary" >> "$hist" 2>/dev/null || true
}

cmd_reset() {
    lines=$(cnt_read) || exit 1
    # +90s margin: wake up after the reset, not a second before it
    reset=$(printf '%s\n' "$lines" | cnt_field 3)
    if [ -z "$reset" ] || [ "$reset" = "-" ]; then
        echo "provider '$CNT_PROVIDER' reports no reset time" >&2; exit 1
    fi
    cnt_epoch_hhmm "$reset" 90
}

# Which agent to wake up. {prompt} is replaced with the task description.
# CONTINUUM_RESUME_CMD wins; otherwise the preset for CONTINUUM_AGENT (default claude).
# Presets arrive with each agent's adapter, once its headless flags are verified.
# NB: not ${VAR:-default} - the `}` inside `{prompt}` would close the expansion early.
cnt_resume_preset() {
    case "$1" in
        claude) printf '%s' 'claude --continue -p "{prompt}" --permission-mode acceptEdits' ;;
        *) return 1 ;;
    esac
}

cnt_resume_cmd() {
    [ -n "${CONTINUUM_RESUME_CMD:-}" ] && { printf '%s' "$CONTINUUM_RESUME_CMD"; return 0; }
    _agent="${CONTINUUM_AGENT:-claude}"
    cnt_resume_preset "$_agent" && return 0
    echo "no resume preset for agent '$_agent' - set CONTINUUM_RESUME_CMD, e.g. 'myagent run \"{prompt}\"'" >&2
    return 1
}

cmd_resume() {
    T="${1:-}"; [ -n "$T" ] || { echo "continuum resume: need HH:MM" >&2; exit 1; }
    DIR="${2:-$PWD}"
    PROMPT="${3:-continue, please}"
    CNT_RESUME_CMD=$(cnt_resume_cmd) || exit 1
    # Headless sessions must never block waiting for input that will never come.
    PROMPT="$PROMPT. Work autonomously: do not ask questions or wait for confirmation — make reasonable decisions, commit results when done, and report what you did in the final message."
    LOG="$CNT_STATE/continuum-resume.log"

    [ -d "$DIR" ] || { echo "no such directory: $DIR" >&2; exit 1; }

    # Escaped copies for generated shell fragments (see sq above).
    sq_dir=$(sq "$DIR"); sq_log=$(sq "$LOG")

    # Substitute {prompt} with awk's index/substr: no globbing, no sed delimiters to
    # collide with, no eval. The prompt lands inside double quotes in the template, so
    # neutralise the characters the shell would still interpret there.
    cmd=$(CNT_TMPL="$CNT_RESUME_CMD" CNT_P="$PROMPT" awk 'BEGIN {
        t = ENVIRON["CNT_TMPL"]; p = ENVIRON["CNT_P"]
        gsub(/[\\"$`]/, "\\\\&", p)
        i = index(t, "{prompt}")
        if (i == 0) print t                          # no placeholder: run as written
        else print substr(t, 1, i - 1) p substr(t, i + 8)
    }')

    delay=$(cnt_hhmm_delay "$T") || exit 1

    # Dry run prints the command it *would* run - the agent need not be installed here.
    if [ -n "${CONTINUUM_DRY_RUN:-}" ]; then
        printf 'would sleep %s then run in %s: %s\n' "$delay" "$DIR" "$cmd"
        return 0
    fi

    agent=$(printf '%s' "$CNT_RESUME_CMD" | sed 's/^ *//'); agent=${agent%% *}
    command -v "$agent" >/dev/null 2>&1 || { echo "\`$agent\` not found in PATH" >&2; exit 1; }

    mkdir -p "$CNT_STATE" 2>/dev/null || true
    printf '\n=== scheduled %s for %s in %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$T" "$DIR" >> "$LOG"

    # The wrapper that runs after the delay: header/footer in the log so concurrent
    # resumes across projects stay attributable, plus a desktop notification with exit
    # status since nothing else is watching a process that runs unattended for hours.
    run_wrapper='
        dir="$2"; cmd="$3"
        cd "$dir" || exit 1
        printf "\n### %s - resumed in %s\n\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$dir"
        sh -c "$cmd"
        status=$?
        printf "\n### end (exit %s) - %s\n" "$status" "$dir"
        if command -v osascript >/dev/null 2>&1; then
            word="finished"; [ "$status" -eq 0 ] || word="FAILED (exit $status)"
            osascript -e "display notification \"$(basename "$dir")\" with title \"continuum resume $word\"" >/dev/null 2>&1 || true
        elif command -v notify-send >/dev/null 2>&1; then
            notify-send "continuum resume finished (exit $status)" "$dir" || true
        fi
    '

    # Try OS scheduler (survives reboots), fall back to nohup (does not).
    scheduled=false

    if [ "$(uname)" = "Darwin" ] && command -v launchctl >/dev/null 2>&1; then
        label="com.continuum.resume.$(date +%s)"
        plist="$HOME/Library/LaunchAgents/${label}.plist"
        mkdir -p "$HOME/Library/LaunchAgents" 2>/dev/null || true
        fire_epoch=$(( $(date +%s) + delay ))
        fire_date=$(date -r "$fire_epoch" +"%Y-%m-%dT%H:%M:%S" 2>/dev/null) || fire_date=""
        if [ -n "$fire_date" ]; then
            # Wakelock: prevent sleep during the wait AND during execution.
            # 1. Pre-emptive caffeinate keeps the machine awake until the job fires.
            wl_pidfile=$(cnt_wakelock_start "$((delay + 300))")
            # 2. The plist wraps the command with caffeinate -i for the execution phase.
            wl_cleanup=""
            [ -n "$wl_pidfile" ] && wl_cleanup="kill \$(cat '${wl_pidfile}') 2&gt;/dev/null || true; rm -f '${wl_pidfile}';"
            escaped_cmd=$(printf '%s' "$cmd" | sed "s/&/\\&amp;/g; s/'/\\&apos;/g; s/\"/\\&quot;/g; s/</\\&lt;/g; s/>/\\&gt;/g")
            cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${label}</string>
  <key>ProgramArguments</key><array>
    <string>caffeinate</string>
    <string>-i</string>
    <string>sh</string>
    <string>-c</string>
    <string>cd '${sq_dir}' &amp;&amp; printf '\n### %s - resumed in %s\n\n' "\$(date '+%Y-%m-%d %H:%M:%S')" '${sq_dir}' &gt;&gt; '${sq_log}' &amp;&amp; ${escaped_cmd} &gt;&gt; '${sq_log}' 2&gt;&amp;1; s=\$?; printf '\n### end (exit %s) - %s\n' "\$s" '${sq_dir}' &gt;&gt; '${sq_log}'; word=finished; [ "\$s" -eq 0 ] || word="FAILED (exit \$s)"; osascript -e "display notification \"\$(basename '${sq_dir}')\" with title \"continuum resume \$word\"" 2&gt;/dev/null || true; ${wl_cleanup}launchctl remove '${label}' 2&gt;/dev/null; rm -f '${plist}'</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>$(date -r "$fire_epoch" +%H | sed 's/^0//')</integer>
    <key>Minute</key><integer>$(date -r "$fire_epoch" +%M | sed 's/^0//')</integer>
  </dict>
  <key>StandardOutPath</key><string>${LOG}</string>
  <key>StandardErrorPath</key><string>${LOG}</string>
</dict></plist>
PLIST
            if launchctl load "$plist" 2>/dev/null; then
                scheduled=true
                printf 'Resuming at %s in %s: "%s"\n' "$T" "$DIR" "$PROMPT"
                printf 'Scheduled via launchd (survives reboot). Label: %s\n' "$label"
                printf 'Sleep inhibited (caffeinate).\n'
                printf 'Cancel: launchctl remove %s   Log: %s\n' "$label" "$LOG"
            else
                rm -f "$plist"
                [ -n "$wl_pidfile" ] && cnt_wakelock_stop "$wl_pidfile"
            fi
        fi
    elif [ "$(uname)" = "FreeBSD" ] && command -v daemon >/dev/null 2>&1; then
        # FreeBSD daemon(8) — detaches cleanly, survives logout but not reboot.
        wrapper_script="sleep ${delay} && cd '${sq_dir}' && printf '\n### %s - resumed in %s\n\n' \"\$(date '+%Y-%m-%d %H:%M:%S')\" '${sq_dir}' >> '${sq_log}' && ${cmd} >> '${sq_log}' 2>&1; s=\$?; printf '\n### end (exit %s) - %s\n' \"\$s\" '${sq_dir}' >> '${sq_log}'"
        daemon -p "$CNT_STATE/.continuum-daemon.pid" sh -c "$wrapper_script"
        pid=$(cat "$CNT_STATE/.continuum-daemon.pid" 2>/dev/null || echo "?")
        scheduled=true
        printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
        printf 'Scheduled via daemon(8) (survives logout, NOT reboot). PID: %s\n' "$pid"
        printf 'Cancel: kill %s   Log: %s\n' "$pid" "$LOG"
    elif command -v systemd-run >/dev/null 2>&1; then
        unit="continuum-resume-$(date +%s)"
        # systemd-inhibit wraps the task to prevent sleep during execution
        inhibit_prefix=""
        command -v systemd-inhibit >/dev/null 2>&1 && inhibit_prefix="systemd-inhibit --what=idle:sleep --who=continuum --why=resume"
        wrapper_script="cd '${sq_dir}' && printf '\n### %s - resumed in %s\n\n' \"\$(date '+%Y-%m-%d %H:%M:%S')\" '${sq_dir}' >> '${sq_log}' && ${inhibit_prefix:+$inhibit_prefix} ${cmd} >> '${sq_log}' 2>&1; s=\$?; printf '\n### end (exit %s) - %s\n' \"\$s\" '${sq_dir}' >> '${sq_log}'; notify-send 'continuum resume finished (exit '\"\$s\"')' '${sq_dir}' 2>/dev/null || true"
        if systemd-run --user --unit="$unit" --on-active="${delay}s" --description="continuum resume" sh -c "$wrapper_script" 2>/dev/null; then
            scheduled=true
            printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
            printf 'Scheduled via systemd (survives reboot). Unit: %s\n' "$unit"
            [ -n "$inhibit_prefix" ] && printf 'Sleep inhibited (systemd-inhibit).\n'
            printf 'Cancel: systemctl --user stop %s.timer   Log: %s\n' "$unit" "$LOG"
        fi
    fi

    if [ "$scheduled" = false ]; then
        # Fallback: nohup sleep. Survives closing the terminal, NOT a reboot.
        # Wakelock wraps the whole process: sleep + task. Releases when it exits.
        wl_wrap=$(cnt_wakelock_wrap)
        nohup ${wl_wrap:+$wl_wrap} sh -c "
            sleep \"\$1\"
            $run_wrapper
        " _ "$delay" "$DIR" "$cmd" >> "$LOG" 2>&1 &
        pid=$!
        printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
        printf 'Scheduled, PID %s (nohup fallback — will NOT survive reboot).\n' "$pid"
        [ -n "${wl_wrap}" ] && printf 'Sleep inhibited (%s).\n' "${wl_wrap%% *}"
        printf 'Cancel: kill %s   Log: %s\n' "$pid" "$LOG"
    fi

    printf 'It runs headless - it will edit code unattended.\n'
}

# The closing sentence tells the agent how to ask the user. Only the wording depends
# on the agent: the tiers, cache and flags do not.
cnt_ask_hint() {
    case "$1" in
        claude) printf '%s' "Do not end the turn silently: run the session-budget skill - briefly state where we stopped, then use AskUserQuestion to ask the user how to spend the rest of the window, offering the options from that skill." ;;
        *)      printf '%s' "Do not end the turn silently: briefly state where we stopped, then ask the user how to spend the rest of the window - finish and wrap up, finish the current batch, save state and schedule a resume after the reset (continuum resume), frugal mode, cheap tasks only, or carry on." ;;
    esac
}

# Agent-neutral core of every in-session warning. Prints the warning when the usage
# crosses a tier not yet warned about in this session, and nothing otherwise. Always
# exits 0 except on bad arguments: a failing provider must never break an agent turn.
# Adapters translate their agent's event into --session and this text into its reply.
cmd_check() {
    sid=default
    agent="${CONTINUUM_AGENT:-generic}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) [ $# -ge 2 ] || { echo "continuum check: --session needs a value" >&2; exit 2; }; sid="$2"; shift 2 ;;
            --agent)   [ $# -ge 2 ] || { echo "continuum check: --agent needs a value" >&2; exit 2; }; agent="$2"; shift 2 ;;
            *) echo "continuum check: unknown argument '$1'" >&2; exit 2 ;;
        esac
    done
    [ -n "${CONTINUUM_OFF:-}" ] && return 0
    [ -z "$sid" ] && sid=unknown
    # The session id lands in a filename: allowlist it to close path traversal
    # (a hostile or corrupt event with session_id "../../x" must stay in-dir).
    case "$sid" in
        *[!A-Za-z0-9_-]*)
            sid=$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_')
            [ -z "$sid" ] && sid=unknown
            ;;
    esac

    # An agent hook that fails spams the user, so never let a missing dir fail us.
    mkdir -p "$CNT_STATE" 2>/dev/null || return 0

    # The flag records the highest tier already warned this session, so each tier fires once.
    flag="$CNT_STATE/.continuum-warned-$sid"
    warned=0
    [ -f "$flag" ] && warned=$(cat "$flag")
    case "$warned" in ''|*[!0-9]*) warned=0 ;; esac

    # The hook runs after every turn, but providers hit rate-limited endpoints, so cache
    # aggressively and back off after a failure ("negative cache").
    # The cache key is derived from the provider list, so sanitize it: a value like
    # CONTINUUM_PROVIDER='../../x' must not escape the state dir.
    cache_key=$(printf '%s' "$CNT_PROVIDER" | tr -c 'A-Za-z0-9_,-' '_')
    cache="$CNT_STATE/.continuum-cache-$cache_key"
    failed="$cache.fail"
    ttl="${CONTINUUM_CACHE_MIN:-10}"

    # fresh <file> -> true if the file was modified within ttl minutes. ttl=0 disables the
    # cache: `find -mmin -0` counts a just-written file as fresh, so guard it explicitly.
    fresh() { [ "$ttl" -gt 0 ] && [ -f "$1" ] && [ -n "$(find "$1" -mmin "-$ttl" 2>/dev/null)" ]; }

    if fresh "$failed"; then
        return 0                                    # recently failed - do not retry yet
    fi

    if fresh "$cache"; then
        lines=$(cat "$cache")
    else
        # offline / rate limited / no token -> stay silent, remember the failure
        lines=$(cnt_read 2>/dev/null) || { : > "$failed"; return 0; }
        printf '%s\n' "$lines" > "$cache"
        rm -f "$failed"
    fi

    # Check both primary (5h) and secondary (7d) windows. Either can trigger a warning.
    # Primary window
    util=$(printf '%s\n' "$lines" | cnt_field 2)
    reset=$(printf '%s\n' "$lines" | cnt_field 3)
    [ -z "$util" ] && return 0

    threshold="${CONTINUUM_THRESHOLD:-80}"
    util_i=${util%%.*}
    case "$util_i" in ''|*[!0-9]*) return 0 ;; esac

    tier=0
    tiers=""
    for t in ${CONTINUUM_TIERS:-80 90 95 99}; do
        [ "$t" -lt "$threshold" ] && continue
        tiers="${tiers:+$tiers/}$t"
        [ "$util_i" -ge "$t" ] && [ "$t" -gt "$tier" ] && tier=$t
    done

    # If utilization dropped below the floor threshold, reset the flag so tiers
    # re-arm. This handles limit top-ups and window rollovers.
    if [ "$util_i" -lt "$threshold" ] && [ "$warned" -gt 0 ]; then
        rm -f "$flag"
        warned=0
    fi

    # Secondary (weekly) window: separate flag, separate tiers.
    flag7="$CNT_STATE/.continuum-warned7d-$sid"
    warned7=0
    [ -f "$flag7" ] && warned7=$(cat "$flag7")
    case "$warned7" in ''|*[!0-9]*) warned7=0 ;; esac

    threshold7="${CONTINUUM_THRESHOLD_7D:-70}"
    tier7=0
    tiers7=""
    line2=$(printf '%s\n' "$lines" | awk 'NR==2')
    if [ -n "$line2" ]; then
        util7=$(printf '%s' "$line2" | awk '{print $2}')
        util7_i=${util7%%.*}
        case "$util7_i" in ''|*[!0-9]*) util7_i=0 ;; esac
        for t in ${CONTINUUM_TIERS_7D:-70 85 95}; do
            [ "$t" -lt "$threshold7" ] && continue
            tiers7="${tiers7:+$tiers7/}$t"
            [ "$util7_i" -ge "$t" ] && [ "$t" -gt "$tier7" ] && tier7=$t
        done
    fi

    # Reset weekly flag if utilization dropped below weekly threshold.
    if [ -n "$line2" ] && [ "$util7_i" -lt "$threshold7" ] && [ "$warned7" -gt 0 ]; then
        rm -f "$flag7"
        warned7=0
    fi

    # Skip if neither window crossed a new tier.
    primary_new=false
    [ "$tier" -gt 0 ] && [ "$tier" -gt "$warned" ] && primary_new=true
    weekly_new=false
    [ "$tier7" -gt 0 ] && [ "$tier7" -gt "$warned7" ] && weekly_new=true
    [ "$primary_new" = false ] && [ "$weekly_new" = false ] && return 0

    when=""
    [ -n "$reset" ] && [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "")

    rest=$(printf '%s\n' "$lines" | awk 'NR>1 {printf "%s window %s%%, ", $1, $2}' | sed 's/, $//')

    # Build reason message depending on which windows triggered.
    reason=""
    if [ "$primary_new" = true ]; then
        printf '%s' "$tier" > "$flag.tmp" && mv "$flag.tmp" "$flag"
        reason="[continuum] The primary usage window is ${util_i}% used (crossed the ${tier}% tier)${when:+, resets at ${when}}"
    fi
    if [ "$weekly_new" = true ]; then
        printf '%s' "$tier7" > "$flag7.tmp" && mv "$flag7.tmp" "$flag7"
        if [ -n "$reason" ]; then
            reason="${reason}. The weekly window also crossed the ${tier7}% tier (${util7_i}% used)"
        else
            reason="[continuum] The weekly window is ${util7_i}% used (crossed the ${tier7}% tier)"
            [ -n "$when" ] && reason="${reason}. Primary: ${util_i}%${when:+, resets at ${when}}"
        fi
    fi
    [ -n "$rest" ] && [ "$primary_new" = true ] && reason="${reason}. Also: ${rest}"

    reason="${reason}. $(cnt_ask_hint "$agent")"
    if [ "$primary_new" = true ]; then
        reason="${reason} Primary tiers fire once each (${tiers})."
    fi
    if [ "$weekly_new" = true ]; then
        reason="${reason} Weekly tiers fire once each (${tiers7})."
    fi
    printf '%s\n' "$reason"
}

# Harness-independent fallback: no hooks, no plugin, works with any agent in any
# shell. Poll until the threshold is crossed, say so, exit. Run it in a spare pane.
cmd_watch() {
    threshold="${CONTINUUM_THRESHOLD:-80}"
    every="${1:-300}"
    while :; do
        if lines=$(cnt_read 2>/dev/null); then
            util=$(printf '%s\n' "$lines" | cnt_field 2)
            util_i=${util%%.*}
            case "$util_i" in ''|*[!0-9]*) util_i=0 ;; esac
            if [ "$util_i" -ge "$threshold" ]; then
                reset=$(printf '%s\n' "$lines" | cnt_field 3)
                when="?"
                [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
                printf '\007continuum: %s%% used, resets at %s\n' "$util_i" "$when"
                printf 'Wrap up, or: continuum resume %s "$PWD" "<task>"\n' \
                       "$(cnt_epoch_hhmm "$reset" 90 2>/dev/null || echo "$when")"
                return 0
            fi
            printf 'continuum: %s%% used, below %s%%\n' "$util_i" "$threshold"
        fi
        sleep "$every"
    done
}

cmd_estimate() {
    lines=$(cnt_read) || exit 1
    first=$(printf '%s\n' "$lines" | head -1)
    util=$(printf '%s' "$first" | awk '{print $2}')
    reset=$(printf '%s' "$first" | awk '{print $3}')
    [ -z "$util" ] && { echo "no utilization data" >&2; exit 1; }
    [ "$reset" = "-" ] && { echo "no reset time available" >&2; exit 1; }
    now=$(date +%s)
    remaining=$(( reset - now ))
    [ "$remaining" -le 0 ] && { printf 'Window has already reset.\n'; return 0; }
    util_i=${util%%.*}
    case "$util_i" in ''|*[!0-9]*) exit 0 ;; esac
    [ "$util_i" -le 0 ] && { printf 'No usage yet.\n'; return 0; }
    left=$(( remaining * (100 - util_i) / util_i ))
    if [ "$left" -ge 3600 ]; then
        printf 'At this pace, ~%sh %sm left before 100%%\n' "$(( left / 3600 ))" "$(( (left % 3600) / 60 ))"
    elif [ "$left" -ge 60 ]; then
        printf 'At this pace, ~%s min left before 100%%\n' "$(( left / 60 ))"
    else
        printf 'At this pace, less than a minute left.\n'
    fi
    when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
    printf 'Currently %s%% used, window resets at %s\n' "$util" "$when"
}

cmd_history() {
    hist="$CNT_STATE/.continuum-history.log"
    if [ ! -f "$hist" ]; then
        echo "No history yet. History is recorded on each status/hook check."
        return 0
    fi
    tail -20 "$hist"
}

cmd_statusline() {
    conf="$CNT_STATE/.continuum-statusline.conf"
    key="${1:-}"
    val="${2:-}"

    if [ -z "$key" ]; then
        printf 'Status-line config (%s):\n' "$conf"
        echo "  format        = $(_sl_get FORMAT '{d%}% d {dr} | {w%}% w {wr}')"
        echo "  format-single = $(_sl_get FORMAT_SINGLE '{d%}% d {dr}')"
        echo "  time          = $(_sl_get TIME_FORMAT '%H:%M')"
        echo "  date          = $(_sl_get DATE_FORMAT '%d.%m')"
        echo "  today         = $(_sl_get TODAY 'today')"
        echo ""
        echo "Tokens: {d%} daily%, {w%} weekly%, {dr} daily reset, {wr} weekly reset"
        return 0
    fi

    if [ "$key" = "reset" ]; then
        rm -f "$conf"
        echo "Status-line config reset to defaults."
        return 0
    fi

    [ -n "$val" ] || { echo "continuum statusline: need a value" >&2; exit 1; }

    case "$key" in
        format)        _sl_set FORMAT "$val" ;;
        format-single) _sl_set FORMAT_SINGLE "$val" ;;
        time)          _sl_set TIME_FORMAT "$val" ;;
        date)          _sl_set DATE_FORMAT "$val" ;;
        today)         _sl_set TODAY "$val" ;;
        *)             echo "continuum statusline: unknown key '$key'" >&2
                       echo "  keys: format, format-single, time, date, today" >&2; exit 1 ;;
    esac
    echo "Set $key = $val"
}

_sl_get() {
    [ -f "$conf" ] || { printf '%s' "$2"; return; }
    v=$(grep "^$1=" "$conf" 2>/dev/null | head -1 | cut -d= -f2-)
    printf '%s' "${v:-$2}"
}

_sl_set() {
    conf="$CNT_STATE/.continuum-statusline.conf"
    mkdir -p "$CNT_STATE" 2>/dev/null || true
    if [ -f "$conf" ] && grep -q "^$1=" "$conf" 2>/dev/null; then
        tmp="$conf.tmp"
        grep -v "^$1=" "$conf" > "$tmp"
        printf '%s=%s\n' "$1" "$2" >> "$tmp"
        mv "$tmp" "$conf"
    else
        printf '%s=%s\n' "$1" "$2" >> "$conf"
    fi
}

cmd_cleanup() {
    cleaned=0
    for f in "$CNT_STATE"/.continuum-warned-* "$CNT_STATE"/.continuum-warned7d-* "$CNT_STATE"/.continuum-cache-* "$CNT_STATE"/.continuum-wakelock-*; do
        [ -f "$f" ] || continue
        age=$(find "$f" -mmin +1440 2>/dev/null)
        if [ -n "$age" ]; then
            rm -f "$f"
            cleaned=$((cleaned + 1))
        fi
    done
    printf 'Cleaned %s stale files.\n' "$cleaned"
}

case "${1:-}" in
    status|"")  cmd_status ;;
    reset)      cmd_reset ;;
    providers)  cnt_providers ;;
    check)      shift; cmd_check "$@" ;;
    watch)      shift; cmd_watch "$@" ;;
    resume)     shift; cmd_resume "$@" ;;
    estimate)   cmd_estimate ;;
    history)    cmd_history ;;
    cleanup)    cmd_cleanup ;;
    statusline) shift; cmd_statusline "$@" ;;
    -h|--help)  usage ;;
    *)          echo "continuum: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
