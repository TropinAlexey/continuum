#!/bin/sh
# continuum - see the limit coming, decide what to do, pick up where you stopped.
#
#   continuum status            utilization of every window the provider reports
#   continuum reset             local HH:MM when the primary window rolls over (+90s)
#   continuum estimate          extrapolate time remaining at current pace
#   continuum providers         list available providers
#   continuum check [--session ID] [--agent NAME]
#                               print a warning if a new tier was crossed, else nothing
#   continuum limit-hit [session] [agent] [dir]
#                               the limit ran out mid-turn: log, notify, note for next start
#   continuum watch [--ide] [seconds]
#                               poll until the threshold is crossed, then say so
#                               (--ide: also show it in a JetBrains IDE via its MCP server)
#   continuum resume HH:MM [dir] [prompt]
#                               schedule the agent to pick up after the reset
#   continuum history           show recent usage snapshots
#   continuum cleanup           remove stale flag/cache files (>24h old)
#   continuum doctor [--fix]    why the warning does not fire: plugin, old hooks, copies
#   continuum install|uninstall --agent codex|gemini|cursor|opencode [--dry-run]
#                               wire an adapter into the agent's own config
#   continuum statusline [key value | reset]
#                               show or configure status-line format
#
#   CONTINUUM_PROVIDER=mock continuum status     pick a provider (default: anthropic)
#   CONTINUUM_AGENT=claude                       pick an agent (default: claude)
#   CONTINUUM_RESUME_CMD='codex exec "{prompt}"' or give the resume command outright
set -eu

# Resolve lib/ whether we run in place, via a PATH symlink, or from a plugin install.
self="$0"; link=$(readlink "$self" 2>/dev/null) && [ -n "$link" ] && case "$link" in
    /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;;
esac
for d in "$(dirname "$self")/../lib" "${CONTINUUM_ROOT:-}/lib" "${CLAUDE_PLUGIN_ROOT:-}/lib"; do
    [ -f "$d/core.sh" ] || continue
    CNT_ROOT=$(cd "$d/.." && pwd)   # core.sh cannot find this itself: $0 is the caller
    export CNT_ROOT
    . "$d/core.sh"
    break
done
command -v cnt_read >/dev/null 2>&1 || { echo "continuum: lib/core.sh not found" >&2; exit 1; }
cnt_set_root_pointer

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

label() {  # pretty names for the windows a provider reports
    case "$1" in
        5h) printf '5 hours ' ;; 7d) printf '7 days  ' ;;
        *)  printf '%-8s' "$1" ;;
    esac
}

# sq <string> -> the string with single quotes escaped for embedding as
# '<value>' inside a generated shell fragment (plist, systemd unit, daemon
# wrapper). Without this a project dir like /tmp/o'brien breaks out of the
# quoting and injects shell. Call at schedule time, embed the result.
sq() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# Capture before piping: `cnt_read | while` would hide the provider's exit status
# behind the loop's, and a caller checking `continuum status` would see success.
cmd_status() {
    lines=$(cnt_read) || exit 1
    printf '%s\n' "$lines" | while read -r window util reset; do
        [ -z "$window" ] && continue
        when="?"
        [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
        printf '%s %5s%%   resets at %s\n' "$(label "$window")" "$util" "$when"
    done
    # Append to history log (best-effort, never fail)
    hist="$CNT_STATE/.continuum-history.log"
    mkdir -p "$CNT_STATE" 2>/dev/null || true
    ts=$(date '+%Y-%m-%d %H:%M')
    summary=$(printf '%s\n' "$lines" | awk '{printf "%s:%s%% ", $1, $2}' | sed 's/ $//')
    printf '%s  %s\n' "$ts" "$summary" >> "$hist" 2>/dev/null || true
}

cmd_reset() {
    lines=$(cnt_read) || exit 1
    # +90s margin: wake up after the reset, not a second before it
    reset=$(printf '%s\n' "$lines" | cnt_field 3)
    if [ -z "$reset" ] || [ "$reset" = "-" ]; then
        echo "provider '$CNT_PROVIDER' reports no reset time" >&2; exit 1
    fi
    cnt_epoch_hhmm "$reset" 90
}

# Which agent to wake up. {prompt} is replaced with the task description.
# CONTINUUM_RESUME_CMD wins; then the bb thread (BB_THREAD_ID); otherwise the preset
# for CONTINUUM_AGENT (default claude). Presets arrive with each agent's adapter,
# once its headless flags are verified.
# NB: not ${VAR:-default} - the `}` inside `{prompt}` would close the expansion early.
cnt_resume_preset() {
    case "$1" in
        claude)   printf '%s' 'claude --continue -p "{prompt}" --permission-mode acceptEdits' ;;
        codex)    printf '%s' 'codex exec resume --last -c sandbox_mode=workspace-write "{prompt}"' ;;
        gemini)   printf '%s' 'gemini --resume latest --approval-mode auto_edit -p "{prompt}"' ;;
        cursor)   printf '%s' 'agent -p --continue "{prompt}"' ;;
        opencode) printf '%s' 'opencode run --continue "{prompt}"' ;;
        junie)    printf '%s' 'junie --skip-update-check --resume --task "{prompt}"' ;;
        *) return 1 ;;
    esac
}

# Inside a bb thread (bb.app sets BB_THREAD_ID for the agent it runs) the resume goes
# back into that same thread, not into a separate headless session. The id is baked in
# now: the scheduled job runs later without the agent's environment.
cnt_bb_resume() {
    case "${BB_THREAD_ID:-}" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
    # Absolute path: launchd runs the job with PATH=/usr/bin:/bin:..., where a `bb`
    # found through the login shell's PATH (~/.bb/bin) is gone. Unquoted in the
    # template, so a path with a space falls back to the bare name.
    _bb=$(command -v bb 2>/dev/null || true)
    [ -z "$_bb" ] && [ -x "$HOME/.bb/bin/bb" ] && _bb="$HOME/.bb/bin/bb"
    case "$_bb" in ''|*' '*) _bb=bb ;; esac
    printf '%s thread tell %s "{prompt}"' "$_bb" "$BB_THREAD_ID"
}

cnt_resume_cmd() {
    [ -n "${CONTINUUM_RESUME_CMD:-}" ] && { printf '%s' "$CONTINUUM_RESUME_CMD"; return 0; }
    cnt_bb_resume && return 0
    _agent="${CONTINUUM_AGENT:-claude}"
    cnt_resume_preset "$_agent" && return 0
    echo "no resume preset for agent '$_agent' - set CONTINUUM_RESUME_CMD, e.g. 'myagent run \"{prompt}\"'" >&2
    return 1
}

cmd_resume() {
    T="${1:-}"; [ -n "$T" ] || { echo "continuum resume: need HH:MM" >&2; exit 1; }
    DIR="${2:-$PWD}"
    PROMPT="${3:-continue, please}"
    CNT_RESUME_CMD=$(cnt_resume_cmd) || exit 1
    # Headless sessions must never block waiting for input that will never come.
    PROMPT="$PROMPT. Work autonomously: do not ask questions or wait for confirmation — make reasonable decisions, commit results when done, and report what you did in the final message."
    LOG="$CNT_STATE/continuum-resume.log"

    [ -d "$DIR" ] || { echo "no such directory: $DIR" >&2; exit 1; }

    # Escaped copies for generated shell fragments (see sq above).
    sq_dir=$(sq "$DIR"); sq_log=$(sq "$LOG")

    # Substitute {prompt} with awk's index/substr: no globbing, no sed delimiters to
    # collide with, no eval. The prompt lands inside double quotes in the template, so
    # neutralise the characters the shell would still interpret there.
    cmd=$(CNT_TMPL="$CNT_RESUME_CMD" CNT_P="$PROMPT" awk 'BEGIN {
        t = ENVIRON["CNT_TMPL"]; p = ENVIRON["CNT_P"]
        gsub(/[\\"$`]/, "\\\\&", p)
        i = index(t, "{prompt}")
        if (i == 0) print t                          # no placeholder: run as written
        else print substr(t, 1, i - 1) p substr(t, i + 8)
    }')

    delay=$(cnt_hhmm_delay "$T") || exit 1

    # Dry run prints the command it *would* run - the agent need not be installed here.
    if [ -n "${CONTINUUM_DRY_RUN:-}" ]; then
        printf 'would sleep %s then run in %s: %s\n' "$delay" "$DIR" "$cmd"
        return 0
    fi

    agent=$(printf '%s' "$CNT_RESUME_CMD" | sed 's/^ *//'); agent=${agent%% *}
    command -v "$agent" >/dev/null 2>&1 || { echo "\`$agent\` not found in PATH" >&2; exit 1; }

    mkdir -p "$CNT_STATE" 2>/dev/null || true
    printf '\n=== scheduled %s for %s in %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$T" "$DIR" >> "$LOG"

    # The wrapper that runs after the delay: header/footer in the log so concurrent
    # resumes across projects stay attributable, plus a desktop notification with exit
    # status since nothing else is watching a process that runs unattended for hours.
    run_wrapper='
        dir="$2"; cmd="$3"
        cd "$dir" || exit 1
        printf "\n### %s - resumed in %s\n\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$dir"
        sh -c "$cmd"
        status=$?
        printf "\n### end (exit %s) - %s\n" "$status" "$dir"
        if command -v osascript >/dev/null 2>&1; then
            word="finished"; [ "$status" -eq 0 ] || word="FAILED (exit $status)"
            osascript -e "on run argv" -e "display notification (item 1 of argv) with title (item 2 of argv)" -e "end run" "$(basename "$dir")" "continuum resume $word" >/dev/null 2>&1 || true
        elif command -v notify-send >/dev/null 2>&1; then
            notify-send "continuum resume finished (exit $status)" "$dir" || true
        fi
    '

    # Try OS scheduler (survives reboots), fall back to nohup (does not).
    scheduled=false

    if [ "$(uname)" = "Darwin" ] && command -v launchctl >/dev/null 2>&1; then
        label="com.continuum.resume.$(date +%s)"
        plist="$HOME/Library/LaunchAgents/${label}.plist"
        mkdir -p "$HOME/Library/LaunchAgents" 2>/dev/null || true
        fire_epoch=$(( $(date +%s) + delay ))
        fire_date=$(date -r "$fire_epoch" +"%Y-%m-%dT%H:%M:%S" 2>/dev/null) || fire_date=""
        if [ -n "$fire_date" ]; then
            # Wakelock: prevent sleep during the wait AND during execution.
            # 1. Pre-emptive caffeinate keeps the machine awake until the job fires.
            wl_pidfile=$(cnt_wakelock_start "$((delay + 300))")
            # 2. The plist wraps the command with caffeinate -i for the execution phase.
            # Every value in the plist is XML-escaped on top of the shell escaping: a
            # directory named `x</string></array><key>Program</key>...` must not reshape the
            # job launchd runs. launchd decodes the entities back before sh sees the code.
            xml() { printf '%s' "$1" | sed "s/&/\\&amp;/g; s/'/\\&apos;/g; s/\"/\\&quot;/g; s/</\\&lt;/g; s/>/\\&gt;/g"; }
            x_dir=$(xml "$sq_dir"); x_log=$(xml "$sq_log"); x_LOG=$(xml "$LOG"); x_plist=$(xml "$(sq "$plist")")
            wl_cleanup=""
            [ -n "$wl_pidfile" ] && x_wl=$(xml "$(sq "$wl_pidfile")") && wl_cleanup="kill \$(cat '${x_wl}') 2&gt;/dev/null || true; rm -f '${x_wl}';"
            escaped_cmd=$(printf '%s' "$cmd" | sed "s/&/\\&amp;/g; s/'/\\&apos;/g; s/\"/\\&quot;/g; s/</\\&lt;/g; s/>/\\&gt;/g")
            cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${label}</string>
  <key>ProgramArguments</key><array>
    <string>caffeinate</string>
    <string>-i</string>
    <string>sh</string>
    <string>-c</string>
    <string>cd '${x_dir}' &amp;&amp; printf '\n### %s - resumed in %s\n\n' "\$(date '+%Y-%m-%d %H:%M:%S')" '${x_dir}' &gt;&gt; '${x_log}' &amp;&amp; ${escaped_cmd} &gt;&gt; '${x_log}' 2&gt;&amp;1; s=\$?; printf '\n### end (exit %s) - %s\n' "\$s" '${x_dir}' &gt;&gt; '${x_log}'; word=finished; [ "\$s" -eq 0 ] || word="FAILED (exit \$s)"; osascript -e "on run argv" -e "display notification (item 1 of argv) with title (item 2 of argv)" -e "end run" "\$(basename '${x_dir}')" "continuum resume \$word" 2&gt;/dev/null || true; ${wl_cleanup}launchctl remove '${label}' 2&gt;/dev/null; rm -f '${x_plist}'</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>$(date -r "$fire_epoch" +%H | sed 's/^0//')</integer>
    <key>Minute</key><integer>$(date -r "$fire_epoch" +%M | sed 's/^0//')</integer>
  </dict>
  <key>StandardOutPath</key><string>${x_LOG}</string>
  <key>StandardErrorPath</key><string>${x_LOG}</string>
</dict></plist>
PLIST
            if launchctl load "$plist" 2>/dev/null; then
                scheduled=true
                printf 'Resuming at %s in %s: "%s"\n' "$T" "$DIR" "$PROMPT"
                printf 'Scheduled via launchd (survives reboot). Label: %s\n' "$label"
                printf 'Sleep inhibited (caffeinate).\n'
                printf 'Cancel: launchctl remove %s   Log: %s\n' "$label" "$LOG"
            else
                rm -f "$plist"
                [ -n "$wl_pidfile" ] && cnt_wakelock_stop "$wl_pidfile"
            fi
        fi
    elif [ "$(uname)" = "FreeBSD" ] && command -v daemon >/dev/null 2>&1; then
        # FreeBSD daemon(8) — detaches cleanly, survives logout but not reboot.
        wrapper_script="sleep ${delay} && cd '${sq_dir}' && printf '\n### %s - resumed in %s\n\n' \"\$(date '+%Y-%m-%d %H:%M:%S')\" '${sq_dir}' >> '${sq_log}' && ${cmd} >> '${sq_log}' 2>&1; s=\$?; printf '\n### end (exit %s) - %s\n' \"\$s\" '${sq_dir}' >> '${sq_log}'"
        daemon -p "$CNT_STATE/.continuum-daemon.pid" sh -c "$wrapper_script"
        pid=$(cat "$CNT_STATE/.continuum-daemon.pid" 2>/dev/null || echo "?")
        scheduled=true
        printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
        printf 'Scheduled via daemon(8) (survives logout, NOT reboot). PID: %s\n' "$pid"
        printf 'Cancel: kill %s   Log: %s\n' "$pid" "$LOG"
    elif command -v systemd-run >/dev/null 2>&1; then
        unit="continuum-resume-$(date +%s)"
        # systemd-inhibit wraps the task to prevent sleep during execution
        inhibit_prefix=""
        command -v systemd-inhibit >/dev/null 2>&1 && inhibit_prefix="systemd-inhibit --what=idle:sleep --who=continuum --why=resume"
        wrapper_script="cd '${sq_dir}' && printf '\n### %s - resumed in %s\n\n' \"\$(date '+%Y-%m-%d %H:%M:%S')\" '${sq_dir}' >> '${sq_log}' && ${inhibit_prefix:+$inhibit_prefix} ${cmd} >> '${sq_log}' 2>&1; s=\$?; printf '\n### end (exit %s) - %s\n' \"\$s\" '${sq_dir}' >> '${sq_log}'; notify-send 'continuum resume finished (exit '\"\$s\"')' '${sq_dir}' 2>/dev/null || true"
        if systemd-run --user --unit="$unit" --on-active="${delay}s" --description="continuum resume" sh -c "$wrapper_script" 2>/dev/null; then
            scheduled=true
            printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
            printf 'Scheduled via systemd (survives reboot). Unit: %s\n' "$unit"
            [ -n "$inhibit_prefix" ] && printf 'Sleep inhibited (systemd-inhibit).\n'
            printf 'Cancel: systemctl --user stop %s.timer   Log: %s\n' "$unit" "$LOG"
        fi
    fi

    if [ "$scheduled" = false ]; then
        # Fallback: nohup sleep. Survives closing the terminal, NOT a reboot.
        # Wakelock wraps the whole process: sleep + task. Releases when it exits.
        wl_wrap=$(cnt_wakelock_wrap)
        nohup ${wl_wrap:+$wl_wrap} sh -c "
            sleep \"\$1\"
            $run_wrapper
        " _ "$delay" "$DIR" "$cmd" >> "$LOG" 2>&1 &
        pid=$!
        printf 'Resuming in %s min (at %s) in %s: "%s"\n' "$(( delay / 60 ))" "$T" "$DIR" "$PROMPT"
        printf 'Scheduled, PID %s (nohup fallback — will NOT survive reboot).\n' "$pid"
        [ -n "${wl_wrap}" ] && printf 'Sleep inhibited (%s).\n' "${wl_wrap%% *}"
        printf 'Cancel: kill %s   Log: %s\n' "$pid" "$LOG"
    fi

    printf 'It runs headless - it will edit code unattended.\n'
}

# The closing sentence tells the agent how to ask the user. Only the wording depends
# on the agent: the tiers, cache and flags do not.
cnt_ask_hint() {
    case "$1" in
        claude) printf '%s' "Do not end the turn silently: run the session-budget skill - briefly state where we stopped, then use AskUserQuestion to ask the user how to spend the rest of the window, offering the options from that skill." ;;
        # Junie has no question tool and its Stop hook fires right before it submits
        # the task, so the question goes at the end of the final message.
        junie)  printf '%s' "Do not end the task silently: run the session-budget skill - briefly state where we stopped, then end your final message by asking the user how to spend the rest of the window, offering the options from that skill. To schedule a resume: CONTINUUM_AGENT=junie continuum resume." ;;
        *)      printf '%s' "Do not end the turn silently: briefly state where we stopped, then ask the user how to spend the rest of the window - finish and wrap up, finish the current batch, save state and schedule a resume after the reset (continuum resume), frugal mode, cheap tasks only, or carry on." ;;
    esac
}

# Agent-neutral core of every in-session warning. Prints the warning when the usage
# crosses a tier not yet warned about in this session, and nothing otherwise. Always
# exits 0 except on bad arguments: a failing provider must never break an agent turn.
# Adapters translate their agent's event into --session and this text into its reply.
cmd_check() {
    sid=default
    agent="${CONTINUUM_AGENT:-generic}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --session) [ $# -ge 2 ] || { echo "continuum check: --session needs a value" >&2; exit 2; }; sid="$2"; shift 2 ;;
            --agent)   [ $# -ge 2 ] || { echo "continuum check: --agent needs a value" >&2; exit 2; }; agent="$2"; shift 2 ;;
            *) echo "continuum check: unknown argument '$1'" >&2; exit 2 ;;
        esac
    done
    [ -n "${CONTINUUM_OFF:-}" ] && return 0
    [ -z "$sid" ] && sid=unknown
    # The session id lands in a filename: allowlist it to close path traversal
    # (a hostile or corrupt event with session_id "../../x" must stay in-dir).
    case "$sid" in
        *[!A-Za-z0-9_-]*)
            sid=$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_')
            [ -z "$sid" ] && sid=unknown
            ;;
    esac

    # An agent hook that fails spams the user, so never let a missing dir fail us.
    mkdir -p "$CNT_STATE" 2>/dev/null || return 0

    # The flag records the highest tier already warned this session, so each tier fires once.
    flag="$CNT_STATE/.continuum-warned-$sid"
    warned=0
    [ -f "$flag" ] && warned=$(cat "$flag")
    case "$warned" in ''|*[!0-9]*) warned=0 ;; esac

    # The hook runs after every turn, but providers hit rate-limited endpoints, so cache
    # aggressively and back off after a failure ("negative cache").
    # The cache key is derived from the provider list, so sanitize it: a value like
    # CONTINUUM_PROVIDER='../../x' must not escape the state dir.
    cache_key=$(printf '%s' "$CNT_PROVIDER" | tr -c 'A-Za-z0-9_,-' '_')
    cache="$CNT_STATE/.continuum-cache-$cache_key"
    failed="$cache.fail"
    ttl="${CONTINUUM_CACHE_MIN:-10}"

    # fresh <file> -> true if the file was modified within ttl minutes. ttl=0 disables the
    # cache: `find -mmin -0` counts a just-written file as fresh, so guard it explicitly.
    fresh() { [ "$ttl" -gt 0 ] && [ -f "$1" ] && [ -n "$(find "$1" -mmin "-$ttl" 2>/dev/null)" ]; }

    if fresh "$failed"; then
        return 0                                    # recently failed - do not retry yet
    fi

    if fresh "$cache"; then
        lines=$(cat "$cache")
    else
        # offline / rate limited / no token -> stay silent, remember the failure
        lines=$(cnt_read 2>/dev/null) || { : > "$failed"; return 0; }
        printf '%s\n' "$lines" > "$cache"
        rm -f "$failed"
    fi

    # Check both primary (5h) and secondary (7d) windows. Either can trigger a warning.
    # Primary window
    util=$(printf '%s\n' "$lines" | cnt_field 2)
    reset=$(printf '%s\n' "$lines" | cnt_field 3)
    [ -z "$util" ] && return 0

    threshold="${CONTINUUM_THRESHOLD:-80}"
    util_i=${util%%.*}
    case "$util_i" in ''|*[!0-9]*) return 0 ;; esac

    tier=0
    tiers=""
    for t in ${CONTINUUM_TIERS:-80 90 95 99}; do
        [ "$t" -lt "$threshold" ] && continue
        tiers="${tiers:+$tiers/}$t"
        [ "$util_i" -ge "$t" ] && [ "$t" -gt "$tier" ] && tier=$t
    done

    # If utilization dropped below the floor threshold, reset the flag so tiers
    # re-arm. This handles limit top-ups and window rollovers.
    if [ "$util_i" -lt "$threshold" ] && [ "$warned" -gt 0 ]; then
        rm -f "$flag"
        warned=0
    fi

    # Secondary (weekly) window: separate flag, separate tiers.
    flag7="$CNT_STATE/.continuum-warned7d-$sid"
    warned7=0
    [ -f "$flag7" ] && warned7=$(cat "$flag7")
    case "$warned7" in ''|*[!0-9]*) warned7=0 ;; esac

    threshold7="${CONTINUUM_THRESHOLD_7D:-70}"
    tier7=0
    tiers7=""
    line2=$(printf '%s\n' "$lines" | awk 'NR==2')
    if [ -n "$line2" ]; then
        util7=$(printf '%s' "$line2" | awk '{print $2}')
        util7_i=${util7%%.*}
        case "$util7_i" in ''|*[!0-9]*) util7_i=0 ;; esac
        for t in ${CONTINUUM_TIERS_7D:-70 85 95}; do
            [ "$t" -lt "$threshold7" ] && continue
            tiers7="${tiers7:+$tiers7/}$t"
            [ "$util7_i" -ge "$t" ] && [ "$t" -gt "$tier7" ] && tier7=$t
        done
    fi

    # Reset weekly flag if utilization dropped below weekly threshold.
    if [ -n "$line2" ] && [ "$util7_i" -lt "$threshold7" ] && [ "$warned7" -gt 0 ]; then
        rm -f "$flag7"
        warned7=0
    fi

    # Skip if neither window crossed a new tier.
    primary_new=false
    [ "$tier" -gt 0 ] && [ "$tier" -gt "$warned" ] && primary_new=true
    weekly_new=false
    [ "$tier7" -gt 0 ] && [ "$tier7" -gt "$warned7" ] && weekly_new=true
    [ "$primary_new" = false ] && [ "$weekly_new" = false ] && return 0

    when=""
    [ -n "$reset" ] && [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "")

    rest=$(printf '%s\n' "$lines" | awk 'NR>1 {printf "%s window %s%%, ", $1, $2}' | sed 's/, $//')

    # Build reason message depending on which windows triggered.
    reason=""
    if [ "$primary_new" = true ]; then
        printf '%s' "$tier" > "$flag.tmp" && mv "$flag.tmp" "$flag"
        reason="[continuum] The primary usage window is ${util_i}% used (crossed the ${tier}% tier)${when:+, resets at ${when}}"
    fi
    if [ "$weekly_new" = true ]; then
        printf '%s' "$tier7" > "$flag7.tmp" && mv "$flag7.tmp" "$flag7"
        reset7=$(printf '%s' "$line2" | awk '{print $3}')
        when7=$(cnt_epoch_dayhhmm "$reset7" 2>/dev/null || echo "")
        if [ -n "$reason" ]; then
            reason="${reason}. The weekly window also crossed the ${tier7}% tier (${util7_i}% used${when7:+, resets ${when7}})"
        else
            reason="[continuum] The weekly window is ${util7_i}% used (crossed the ${tier7}% tier)${when7:+, resets ${when7}}"
            [ -n "$when" ] && reason="${reason}. Primary: ${util_i}%${when:+, resets at ${when}}"
        fi
    fi
    [ -n "$rest" ] && [ "$primary_new" = true ] && reason="${reason}. Also: ${rest}"

    reason="${reason}. $(cnt_ask_hint "$agent")"
    if [ "$primary_new" = true ]; then
        reason="${reason} Primary tiers fire once each (${tiers})."
    fi
    if [ "$weekly_new" = true ]; then
        reason="${reason} Weekly tiers fire once each (${tiers7})."
    fi
    printf '%s\n' "$reason"
}

# The limit ran out in the middle of a turn (StopFailure / rate_limit in Claude Code and
# Junie). Nobody can be asked at that moment, so this only tells: a line in the resume
# log, a desktop notification, a note the next session start shows once. With
# CONTINUUM_RESUME_ON_LIMIT=1 - consent the user gave in advance - it also schedules a
# resume for the reset. Agent-neutral: adapters pass session, agent and directory.
# Prints the message; always exits 0, a failing hook must not spam the user.
cmd_limit_hit() {
    sid=$(printf '%s' "${1:-unknown}" | tr -c 'A-Za-z0-9_-' '_')
    agent="${2:-${CONTINUUM_AGENT:-claude}}"
    dir="${3:-$PWD}"
    [ -n "${CONTINUUM_OFF:-}" ] && return 0
    mkdir -p "$CNT_STATE" 2>/dev/null || return 0

    # No network from a turn that just failed on the limit: the exhausted window is the
    # cached line with the highest utilization (primary or weekly).
    cache_key=$(printf '%s' "$CNT_PROVIDER" | tr -c 'A-Za-z0-9_,-' '_')
    best=$(awk 'NF >= 3 { u = $2 + 0; if (!n || u > bu) { bu = u; n = NR; r = $3 } }
                END { if (n) print n, r }' "$CNT_STATE/.continuum-cache-$cache_key" 2>/dev/null)
    nr=${best%% *}; reset=${best#* }
    case "$reset" in ''|*[!0-9]*|?????????????*) reset="" ;; esac
    when=""
    if [ -n "$reset" ]; then
        if [ "$nr" = 1 ]; then when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || true)
        else when=$(cnt_epoch_dayhhmm "$reset" 2>/dev/null || true); fi
    fi

    # Once per session per window.
    flag="$CNT_STATE/.continuum-limit-$sid"
    [ -f "$flag" ] && [ "$(cat "$flag" 2>/dev/null)" = "${reset:--}" ] && return 0
    printf '%s' "${reset:--}" > "$flag" 2>/dev/null || true

    msg="limit hit in $(basename "$dir")${when:+, resets ${when}}"
    if [ "${CONTINUUM_RESUME_ON_LIMIT:-}" = 1 ]; then
        now=$(date +%s)
        if [ -z "$reset" ]; then
            msg="$msg. No reset time known, so no resume was scheduled - run continuum resume with your task"
        elif [ "$reset" -le "$now" ] || [ $((reset - now)) -gt 86400 ]; then
            # `continuum resume` takes HH:MM (the next 24 h); a weekly reset days away
            # would fire too early and hit the limit again.
            msg="$msg. The reset is more than a day away, so no resume was scheduled - run continuum resume with your task then"
        else
            rflag="$CNT_STATE/.continuum-limit-resume-$(printf '%s' "$dir" | cksum | cut -d' ' -f1)"
            if [ "$(cat "$rflag" 2>/dev/null)" = "$reset" ]; then
                msg="$msg. A resume for this directory is already scheduled"
            else
                hhmm=$(cnt_epoch_hhmm "$reset" 90)
                task="The previous turn stopped on the usage limit. Continue the interrupted work from where it stopped"
                if out=$(CONTINUUM_AGENT="$agent"; cmd_resume "$hhmm" "$dir" "$task" 2>&1); then
                    printf '%s' "$reset" > "$rflag" 2>/dev/null || true
                    msg="$msg. Resume scheduled for $hhmm (CONTINUUM_RESUME_ON_LIMIT=1). $(printf '%s' "$out" | grep -E '^(Cancel|would)' | head -1)"
                else
                    msg="$msg. Scheduling the resume failed: $(printf '%s' "$out" | head -1)"
                fi
            fi
        fi
    else
        msg="$msg - run continuum resume with your task"
    fi

    # The directory name ends up in the log, the note and the agent's context at the next
    # session start: no control characters (a newline or tab would forge note lines).
    msg=$(printf '%s' "$msg" | tr -d '\000-\037\177')
    printf '\n### limit hit - %s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >> "$CNT_STATE/continuum-resume.log" 2>/dev/null || true
    printf '%s\t%s\n' "$(date +%s)" "$msg" >> "$CNT_STATE/.continuum-limit-notes" 2>/dev/null || true
    cnt_notify "continuum" "$msg"
    printf '%s\n' "$msg"
}

# Harness-independent fallback: no hooks, no plugin, works with any agent in any
# shell. Poll until the threshold is crossed, say so, exit. Run it in a spare pane.
# JetBrains IDE (R1): the AI chat runs agents through ACP, where no hooks fire, so an
# outside poller shows the warning in the IDE through its MCP server. The IDE opens only
# files inside an open project, so the text goes to <project>/.git/continuum-warning.md:
# inside the project, never tracked, never in `git status`. Opt-in: `watch --ide` only.

# The IDE's MCP endpoints: CONTINUUM_IDE_MCP_URL, or the loopback ports JetBrains IDE
# processes listen on (their MCP port changes on every restart). Never other processes.
ide_endpoints() {
    if [ -n "${CONTINUUM_IDE_MCP_URL:-}" ]; then printf '%s\n' "$CONTINUUM_IDE_MCP_URL"; return 0; fi
    command -v lsof >/dev/null 2>&1 || return 0
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk '
        tolower($1) ~ /^(rider|rustrover|idea|pycharm|goland|webstorm|clion|phpstorm|rubymine|datagrip|aqua|dataspell)/ \
        && $9 ~ /^127\.0\.0\.1:[0-9]+$/ { sub(/.*:/, "", $9); print "http://127.0.0.1:" $9 "/stream" }' | sort -u
}

# ide_rpc URL SESSION JSON -> line 1: session id, then the response body (SSE "data: "
# stripped). CONTINUUM_IDE_MCP_CMD replaces the transport (tests): same arguments, same output.
ide_rpc() {
    if [ -n "${CONTINUUM_IDE_MCP_CMD:-}" ]; then
        # shellcheck disable=SC2086
        $CONTINUUM_IDE_MCP_CMD "$1" "$2" "$3"; return
    fi
    command -v curl >/dev/null 2>&1 || return 1
    _h="$CNT_STATE/.continuum-ide.$$.h"
    if [ -n "$2" ]; then
        _b=$(curl -s -m 5 -D "$_h" -X POST -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -H "Mcp-Session-Id: $2" -d "$3" "$1") || { rm -f "$_h"; return 1; }
    else
        _b=$(curl -s -m 5 -D "$_h" -X POST -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d "$3" "$1") || { rm -f "$_h"; return 1; }
    fi
    _s=$(awk -F': *' 'tolower($1) == "mcp-session-id" { print $2 }' "$_h" 2>/dev/null | tr -d '\r')
    rm -f "$_h"
    printf '%s\n%s\n' "${_s:-$2}" "$(printf '%s' "$_b" | sed 's/^data: //')"
}

# ide_show TEXT [DIR] -> 0 when an IDE with DIR's project open showed the warning.
ide_show() {
    top=$(git -C "${2:-$PWD}" rev-parse --show-toplevel 2>/dev/null) && [ -d "$top/.git" ] || {
        echo "continuum: --ide needs a git checkout (the warning goes to .git/continuum-warning.md)" >&2; return 1; }
    printf '%s\n' "$1" > "$top/.git/continuum-warning.md" 2>/dev/null || return 1
    mkdir -p "$CNT_STATE" 2>/dev/null || true     # ide_rpc keeps response headers there
    jtop=$(printf '%s' "$top" | sed 's/\\/\\\\/g; s/"/\\"/g')
    for url in $(ide_endpoints); do
        r=$(ide_rpc "$url" "" '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"continuum","version":"1"}}}') || continue
        printf '%s' "$r" | grep -q 'MCP Server' || continue
        sid=$(printf '%s\n' "$r" | head -1)
        ide_rpc "$url" "$sid" '{"jsonrpc":"2.0","method":"notifications/initialized"}' >/dev/null 2>&1 || true
        r=$(ide_rpc "$url" "$sid" '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"open_file_in_editor","arguments":{"filePath":".git/continuum-warning.md","rootFolder":"'"$jtop"'"}}}') || continue
        printf '%s' "$r" | grep -qE '"isError"[[:space:]]*:[[:space:]]*true|"error"[[:space:]]*:' && continue
        printf '%s' "$r" | grep -q '"result"' && return 0
    done
    echo "continuum: no JetBrains IDE with $top open answered on MCP (Settings | Tools | MCP Server)" >&2
    return 1
}

cmd_watch() {
    threshold="${CONTINUUM_THRESHOLD:-80}"
    every=300; ide=""
    for a in "$@"; do
        case "$a" in --ide) ide=1 ;; *[!0-9]*|'') echo "continuum watch: unknown argument '$a'" >&2; exit 1 ;; *) every=$a ;; esac
    done
    while :; do
        if lines=$(cnt_read 2>/dev/null); then
            util=$(printf '%s\n' "$lines" | cnt_field 2)
            util_i=${util%%.*}
            case "$util_i" in ''|*[!0-9]*) util_i=0 ;; esac
            if [ "$util_i" -ge "$threshold" ]; then
                reset=$(printf '%s\n' "$lines" | cnt_field 3)
                when="?"
                [ "$reset" != "-" ] && when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
                at=$(cnt_epoch_hhmm "$reset" 90 2>/dev/null || echo "$when")
                printf '\007continuum: %s%% used, resets at %s\n' "$util_i" "$when"
                printf 'Wrap up, or: continuum resume %s "$PWD" "<task>"\n' "$at"
                if [ -n "$ide" ]; then
                    ide_show "# continuum: ${util_i}% of the usage window used

Resets at ${when}. Tell the agent in the chat to wrap up, or to save its state, then:

    continuum resume ${at} \"\$PWD\" \"<the task to pick up>\"

(Shown by \`continuum watch --ide\`. This file lives in .git/ and is never committed.)" "$PWD" || true
                fi
                return 0
            fi
            printf 'continuum: %s%% used, below %s%%\n' "$util_i" "$threshold"
        fi
        sleep "$every"
    done
}

cmd_estimate() {
    lines=$(cnt_read) || exit 1
    first=$(printf '%s\n' "$lines" | head -1)
    util=$(printf '%s' "$first" | awk '{print $2}')
    reset=$(printf '%s' "$first" | awk '{print $3}')
    [ -z "$util" ] && { echo "no utilization data" >&2; exit 1; }
    [ "$reset" = "-" ] && { echo "no reset time available" >&2; exit 1; }
    now=$(date +%s)
    remaining=$(( reset - now ))
    [ "$remaining" -le 0 ] && { printf 'Window has already reset.\n'; return 0; }
    util_i=${util%%.*}
    case "$util_i" in ''|*[!0-9]*) exit 0 ;; esac
    [ "$util_i" -le 0 ] && { printf 'No usage yet.\n'; return 0; }
    left=$(( remaining * (100 - util_i) / util_i ))
    if [ "$left" -ge 3600 ]; then
        printf 'At this pace, ~%sh %sm left before 100%%\n' "$(( left / 3600 ))" "$(( (left % 3600) / 60 ))"
    elif [ "$left" -ge 60 ]; then
        printf 'At this pace, ~%s min left before 100%%\n' "$(( left / 60 ))"
    else
        printf 'At this pace, less than a minute left.\n'
    fi
    when=$(cnt_epoch_hhmm "$reset" 2>/dev/null || echo "?")
    printf 'Currently %s%% used, window resets at %s\n' "$util" "$when"
}

cmd_history() {
    hist="$CNT_STATE/.continuum-history.log"
    if [ ! -f "$hist" ]; then
        echo "No history yet. History is recorded on each status/hook check."
        return 0
    fi
    tail -20 "$hist"
}

cmd_statusline() {
    conf="$CNT_STATE/.continuum-statusline.conf"
    key="${1:-}"
    val="${2:-}"

    if [ -z "$key" ]; then
        printf 'Status-line config (%s):\n' "$conf"
        echo "  format        = $(_sl_get FORMAT '{d%} d {dr} | {w%} w {wr}')"
        echo "  format-single = $(_sl_get FORMAT_SINGLE '{d%} d {dr}')"
        echo "  time          = $(_sl_get TIME_FORMAT '%H:%M')"
        echo "  date          = $(_sl_get DATE_FORMAT '%d.%m')"
        echo "  today         = $(_sl_get TODAY 'today')"
        echo ""
        echo "Tokens: {d%} daily%, {w%} weekly%, {dr} daily reset, {wr} weekly reset"
        return 0
    fi

    if [ "$key" = "reset" ]; then
        rm -f "$conf"
        echo "Status-line config reset to defaults."
        return 0
    fi

    [ -n "$val" ] || { echo "continuum statusline: need a value" >&2; exit 1; }

    case "$key" in
        format)        _sl_set FORMAT "$val" ;;
        format-single) _sl_set FORMAT_SINGLE "$val" ;;
        time)          _sl_set TIME_FORMAT "$val" ;;
        date)          _sl_set DATE_FORMAT "$val" ;;
        today)         _sl_set TODAY "$val" ;;
        *)             echo "continuum statusline: unknown key '$key'" >&2
                       echo "  keys: format, format-single, time, date, today" >&2; exit 1 ;;
    esac
    echo "Set $key = $val"
}

_sl_get() {
    [ -f "$conf" ] || { printf '%s' "$2"; return; }
    v=$(grep "^$1=" "$conf" 2>/dev/null | head -1 | cut -d= -f2-)
    printf '%s' "${v:-$2}"
}

_sl_set() {
    conf="$CNT_STATE/.continuum-statusline.conf"
    mkdir -p "$CNT_STATE" 2>/dev/null || true
    if [ -f "$conf" ] && grep -q "^$1=" "$conf" 2>/dev/null; then
        tmp="$conf.tmp"
        grep -v "^$1=" "$conf" > "$tmp"
        printf '%s=%s\n' "$1" "$2" >> "$tmp"
        mv "$tmp" "$conf"
    else
        printf '%s=%s\n' "$1" "$2" >> "$conf"
    fi
}

# Why does the warning not fire? One line per check - ok / warn / fail / skip - and exit 1
# on any fail. Read-only; `--fix` applies only the safe fixes (statusline copy, root
# pointer) and prints the manual step for the rest. Never edits settings.json hooks.
cmd_doctor() {
    fix=""; [ "${1:-}" = "--fix" ] && fix=1
    fails=0
    say() { printf '%-4s %s\n' "$1" "$2"; [ "$1" = fail ] && fails=$((fails + 1)); return 0; }
    ver() { grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/'; }
    mine=$(ver "$CNT_ROOT/.claude-plugin/plugin.json")

    if lines=$(cnt_read 2>/dev/null) && [ -n "$lines" ]; then
        say ok "provider $CNT_PROVIDER: $(printf '%s\n' "$lines" | awk 'NR==1 {print $1, $2 "%"}')"
    else
        say fail "provider $CNT_PROVIDER gives no numbers (offline, rate limited, or no token): continuum status"
    fi

    if mkdir -p "$CNT_STATE" 2>/dev/null && : > "$CNT_STATE/.continuum-doctor" 2>/dev/null; then
        rm -f "$CNT_STATE/.continuum-doctor"; say ok "state dir $CNT_STATE"
    else
        say fail "state dir $CNT_STATE is not writable"
    fi

    ptr=$(cat "$CNT_STATE/root" 2>/dev/null || true)
    if [ -n "$ptr" ] && [ -f "$ptr/bin/continuum" ]; then
        say ok "root pointer $ptr"
    elif [ -n "$fix" ]; then
        cnt_set_root_pointer 2>/dev/null && say ok "root pointer rewritten: $CNT_ROOT" || say fail "root pointer: cannot write $CNT_STATE/root"
    else
        say warn "root pointer ${ptr:-missing} (a statusline copy cannot find the code): continuum doctor --fix"
    fi

    cdir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; settings="$cdir/settings.json"
    if [ ! -f "$settings" ]; then
        say skip "Claude Code: no $settings"
    else
        if grep -q '"continuum@[^"]*"[[:space:]]*:[[:space:]]*true' "$settings"; then
            say ok "Claude Code plugin enabled"
        else
            say fail "Claude Code plugin not enabled in $settings: /plugin install continuum@continuum"
        fi
        legacy=$(grep -oE 'token-budget-check\.sh|\.claude/lib/usage\.sh|/hooks/continuum-check\.(sh|ps1)' "$settings" | sort -u | tr '\n' ' ')
        if [ -n "$legacy" ]; then
            say warn "old hooks still wired in $settings: ${legacy% } - remove them from \"hooks\" (the plugin brings its own)"
        else
            say ok "no old hooks in settings.json"
        fi
        copy="$cdir/hooks/statusline.sh"; src="$CNT_ROOT/adapters/claude/statusline.sh"
        if [ ! -f "$copy" ] || ! grep -q continuum "$copy" 2>/dev/null; then
            say skip "statusline copy: none"
        elif cmp -s "$src" "$copy"; then
            say ok "statusline copy current"
        elif [ -n "$fix" ]; then
            cp "$src" "$copy" 2>/dev/null && say ok "statusline copy refreshed: $copy" || say fail "statusline copy: cannot write $copy"
        else
            say warn "statusline copy $copy differs from this version: continuum doctor --fix"
        fi
        cached=$(ls "$cdir/plugins/cache/continuum/continuum" 2>/dev/null | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
        if [ -n "$cached" ] && [ -n "$mine" ] && [ "$cached" != "$mine" ]; then
            say warn "Claude Code runs plugin $cached, this code is $mine: /plugin update continuum, then restart the session"
        elif [ -n "$cached" ]; then
            say ok "Claude Code plugin version $cached"
        fi
    fi

    jhome="${JUNIE_HOME:-$HOME/.junie}"
    jext=$(ls -d "$jhome"/extensions/*/continuum 2>/dev/null | head -1)
    if [ -z "$jext" ]; then
        say skip "Junie: continuum extension not installed"
    else
        jv=$(ver "$jext/.claude-plugin/plugin.json")
        if [ -n "$mine" ] && [ "$jv" != "$mine" ]; then
            say warn "Junie extension is ${jv:-unknown}, this code is $mine: in Junie, /extensions -> update continuum"
        else
            say ok "Junie extension ${jv:-?}"
        fi
    fi

    [ "$fails" -eq 0 ]
}

# `continuum install --agent <x> [--dry-run]` / `uninstall --agent <x>` (R5): wire an
# adapter into an agent's own config. No JSON parser, so only shapes we can edit safely:
# no file -> create it; a file without "hooks" -> insert the block (backup first); hooks
# already there -> refuse and print the snippet. Uninstall undoes it only while the file
# is unchanged since install; otherwise it prints the manual step. Never half-writes.
inst_file() {
    case "$1" in
        codex)  printf '%s' "${CODEX_HOME:-$HOME/.codex}/hooks.json" ;;
        gemini) printf '%s' "$HOME/.gemini/settings.json" ;;
        cursor) printf '%s' "$HOME/.cursor/hooks.json" ;;
        opencode) printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins/continuum.js" ;;
    esac
}
inst_hooks() { # the "hooks" member for agent $1, code at $2
    case "$1" in
        codex)  printf '  "hooks": {\n    "Stop": [{ "hooks": [{ "type": "command", "command": "sh \\"%s/adapters/codex/stop.sh\\"" }] }],\n    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "sh \\"%s/adapters/codex/tool-check.sh\\"" }] }]\n  }' "$2" "$2" ;;
        gemini) printf '  "hooks": {\n    "AfterAgent": [{ "hooks": [{ "type": "command", "command": "sh \\"%s/adapters/gemini/after-agent.sh\\"" }] }],\n    "AfterTool": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "sh \\"%s/adapters/gemini/after-tool.sh\\"" }] }]\n  }' "$2" "$2" ;;
        cursor) printf '  "version": 1,\n  "hooks": {\n    "stop": [{ "command": "sh \\"%s/adapters/cursor/stop.sh\\"" }],\n    "postToolUse": [{ "command": "sh \\"%s/adapters/cursor/tool-check.sh\\"" }]\n  }' "$2" "$2" ;;
    esac
}

cmd_install() {
    action="$1"; shift
    agent=""; dry=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent) agent="${2:-}"; shift 2 || shift ;;
            --dry-run) dry=1; shift ;;
            *) echo "continuum $action: unknown argument '$1'" >&2; exit 1 ;;
        esac
    done
    case "$agent" in
        claude) echo "Claude Code installs continuum as a plugin: claude plugin install continuum@continuum (or /plugin in a session). See README → Claude Code."; return 0 ;;
        junie)  echo "Junie installs continuum as an extension: in Junie, /extensions → add the marketplace https://github.com/TropinAlexey/continuum → install continuum."; return 0 ;;
        codex|gemini|cursor|opencode) ;;
        *) echo "continuum $action: --agent codex|gemini|cursor|opencode (claude and junie install as plugins)" >&2; exit 1 ;;
    esac
    # The code path lands inside a shell command in the agent's config: allow only
    # characters that need no quoting, so no path can turn into shell syntax.
    root=$CNT_ROOT
    case "$root" in *[!A-Za-z0-9/._+@~-]*) echo "continuum $action: the code path '$root' has characters that are unsafe in a hook command; install continuum to a plain path (e.g. ~/.continuum)" >&2; exit 1 ;; esac
    f=$(inst_file "$agent"); rec="$CNT_STATE/.continuum-install-$agent"
    mkdir -p "$CNT_STATE" 2>/dev/null || true

    if [ "$agent" = opencode ]; then
        src="$root/adapters/opencode/continuum.js"
        if [ "$action" = install ]; then
            if [ -L "$f" ] && [ "$(readlink "$f")" = "$src" ]; then echo "already installed: $f"; return 0; fi
            [ -e "$f" ] || [ -L "$f" ] && { echo "continuum install: $f exists and is not ours; remove it, then: ln -s '$src' '$f'" >&2; exit 1; }
            [ -n "$dry" ] && { echo "would link $f -> $src"; return 0; }
            mkdir -p "$(dirname "$f")" && ln -s "$src" "$f" || exit 1
            # Git Bash without symlink support copies instead: a stale copy that never
            # updates and that uninstall cannot recognize. Undo it and say so.
            if [ ! -L "$f" ]; then
                rm -f "$f"
                echo "continuum install: this shell cannot create symlinks (Git Bash: set MSYS=winsymlinks:nativestrict and enable Developer Mode), or link $f to $src yourself" >&2; exit 1
            fi
            echo "linked $f -> $src (restart opencode)"
        else
            if [ -L "$f" ] && [ "$(readlink "$f")" = "$src" ]; then
                [ -n "$dry" ] && { echo "would remove $f"; return 0; }
                rm -f "$f" && echo "removed $f"
            else echo "nothing to uninstall: $f is not continuum's link"; fi
        fi
        return 0
    fi

    # A symlinked config (dotfiles) would be replaced by a plain file on mv: leave it alone.
    [ -L "$f" ] && { echo "continuum $action: $f is a symlink (dotfiles?); edit the file it points to by hand" >&2; exit 1; }
    block=$(inst_hooks "$agent" "$root")
    if [ "$action" = install ]; then
        if [ -f "$f" ] && grep -q "/adapters/$agent/" "$f"; then echo "already installed: $f"; return 0; fi
        if [ ! -f "$f" ] || [ -z "$(tr -d ' \t\r\n{}' < "$f")" ]; then
            mode=created; new=$(printf '{\n%s\n}\n' "$block")
        elif grep -q '"hooks"[[:space:]]*:' "$f"; then
            printf 'continuum install: %s already has "hooks"; merge these entries by hand:\n%s\n' "$f" "$block" >&2; exit 1
        elif [ "$(sed -n '/[^[:space:]]/{p;q;}' "$f" | cut -c1)" != "{" ]; then
            echo "continuum install: $f does not start with '{'; not touching it" >&2; exit 1
        else
            mode=inserted
            new=$(CNT_B="$block" awk 'done == 0 && index($0, "{") { i = index($0, "{"); print substr($0, 1, i); print ENVIRON["CNT_B"] ","; rest = substr($0, i + 1); if (rest ~ /[^[:space:]]/) print rest; done = 1; next } { print }' "$f") || new=""
        fi
        # Never write a config we did not build in full.
        case "$new" in *'"hooks"'*) ;; *) echo "continuum install: could not build the new $f; not touching it" >&2; exit 1 ;; esac
        if [ -n "$dry" ]; then printf 'would write %s:\n%s\n' "$f" "$new"; return 0; fi
        mkdir -p "$(dirname "$f")" || exit 1
        [ "$mode" = inserted ] && { cp "$f" "$f.continuum-bak" || exit 1; }
        [ -f "$f" ] && [ "$mode" = created ] && cp "$f" "$f.continuum-bak"
        printf '%s\n' "$new" > "$f.continuum-tmp" && mv "$f.continuum-tmp" "$f" || { rm -f "$f.continuum-tmp"; exit 1; }
        { printf '%s\n' "$mode"; cksum < "$f"; } > "$rec"
        if [ -f "$f.continuum-bak" ]; then echo "installed: $f (backup: $f.continuum-bak)"; else echo "installed: $f"; fi
        [ "$agent" = codex ] && echo "Codex runs hooks only once trusted: approve them in /hooks."
        return 0
    fi
    # uninstall
    [ -f "$rec" ] || { echo "nothing to uninstall: continuum did not install into $f"; return 0; }
    mode=$(sed -n 1p "$rec"); sum=$(sed -n 2p "$rec")
    if [ ! -f "$f" ]; then rm -f "$rec"; echo "already gone: $f"; return 0; fi
    if [ "$(cksum < "$f")" != "$sum" ]; then
        printf 'continuum uninstall: %s changed since install; remove the hooks that point to %s/adapters/%s/ by hand\n' "$f" "$root" "$agent" >&2; exit 1
    fi
    [ -n "$dry" ] && { echo "would restore $f ($mode)"; return 0; }
    if [ -f "$f.continuum-bak" ]; then mv "$f.continuum-bak" "$f"; else rm -f "$f"; fi
    rm -f "$rec"; echo "uninstalled: $f"
}

cmd_cleanup() {
    cleaned=0
    for f in "$CNT_STATE"/.continuum-warned-* "$CNT_STATE"/.continuum-warned7d-* "$CNT_STATE"/.continuum-cache-* "$CNT_STATE"/.continuum-wakelock-* "$CNT_STATE"/.continuum-limit-*; do
        [ -f "$f" ] || continue
        age=$(find "$f" -mmin +1440 2>/dev/null)
        if [ -n "$age" ]; then
            rm -f "$f"
            cleaned=$((cleaned + 1))
        fi
    done
    printf 'Cleaned %s stale files.\n' "$cleaned"
}

case "${1:-}" in
    status|"")  cmd_status ;;
    reset)      cmd_reset ;;
    providers)  cnt_providers ;;
    check)      shift; cmd_check "$@" ;;
    limit-hit)  shift; cmd_limit_hit "$@" ;;
    watch)      shift; cmd_watch "$@" ;;
    resume)     shift; cmd_resume "$@" ;;
    estimate)   cmd_estimate ;;
    history)    cmd_history ;;
    cleanup)    cmd_cleanup ;;
    install)    shift; cmd_install install "$@" ;;
    uninstall)  shift; cmd_install uninstall "$@" ;;
    doctor)     shift; cmd_doctor "$@" || exit 1 ;;
    statusline) shift; cmd_statusline "$@" ;;
    -h|--help)  usage ;;
    *)          echo "continuum: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
